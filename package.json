{
  "name": "blackteal-site-diagram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive live site diagram for a grid-connected BESS supporting a data-center load - BlackTeal frontend exercise.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
